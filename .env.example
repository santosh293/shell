# Server
PORT=3000
# Admin login (CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Random long string used to sign admin session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# ---- WhatsApp automatic notifications (optional, pick ONE) ----
# Option A: Meta WhatsApp Cloud API (official)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Option B: CallMeBot (free, easiest - https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_APIKEY=
# The admin number that receives order alerts (country code, digits only, e.g. 919876543210).
# If empty, the WhatsApp number from Admin > Settings is used.
WHATSAPP_ADMIN_NUMBER=

# ---- Online payments (optional) ----
# Razorpay keys (cards / UPI / netbanking). Leave empty to hide the "Pay Online" option.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
